MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 28511913}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d3a0dfe3595238488ebb905d80f279a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  interactionPrompt: {fileID: 595355206}
  interactionPoint: {fileID: 0}
  dialogueLines:
  - speakerName: "\u0E2D\u0E34\u0E07"
    text: "\u0E2A\u0E27\u0E31\u0E2A\u0E14\u0E35\u0E08\u0E31\u0E19\u0E17\u0E23\u0E4C!"
  - speakerName: "\u0E2D\u0E34\u0E07"
    text: "\u0E21\u0E32\u0E40\u0E25\u0E48\u0E19\u0E01\u0E31\u0E19\u0E40\u0E16\u0E2D\u0E30"
  - speakerName: "\u0E08\u0E31\u0E19\u0E17\u0E23\u0E4C (\u0E1C\u0E39\u0E49\u0E40\u0E25\u0E48\u0E19)"
    text: "\u0E2A\u0E27\u0E31\u0E2A\u0E14\u0E35!"
  - speakerName: "\u0E08\u0E31\u0E19\u0E17\u0E23\u0E4C (\u0E1C\u0E39\u0E49\u0E40\u0E25\u0E48\u0E19)"
    text: "\u0E08\u0E30\u0E40\u0E25\u0E48\u0E19\u0E2D\u0E30\u0E44\u0E23\u0E2B\u0E23\u0E2D"
  - speakerName: "\u0E2D\u0E34\u0E07"
    text: "\u0E40\u0E25\u0E48\u0E19\u0E0B\u0E48\u0E2D\u0E19\u0E41\u0E2D\u0E1A\u0E01\u0E31\u0E19\u0E44\u0E2B\u0E21"
  - speakerName: "\u0E2D\u0E34\u0E07"
    text: "\u0E40\u0E23\u0E32\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E40\u0E25\u0E48\u0E19\u0E0B\u0E48\u0E2D\u0E19\u0E41\u0E2D\u0E1A\u0E14\u0E49\u0E27\u0E22\u0E01\u0E31\u0E19\u0E19\u0E32\u0E19\u0E41\u0E25\u0E49\u0E27"
  - speakerName: "\u0E08\u0E31\u0E19\u0E17\u0E23\u0E4C (\u0E1C\u0E39\u0E49\u0E40\u0E25\u0E48\u0E19)"
    text: "\u0E44\u0E14\u0E49\u0E40\u0E25\u0E22 \u0E40\u0E23\u0E34\u0E48\u0E21\u0E40\u0E25\u0E22\u0E44\u0E2B\u0E21"
  - speakerName: "\u0E2D\u0E34\u0E07"
    text: "\u0E23\u0E2D\u0E1A\u0E41\u0E23\u0E01\u0E09\u0E31\u0E19\u0E08\u0E30\u0E40\u0E1B\u0E47\u0E19\u0E04\u0E19\u0E2B\u0E32\u0E01\u0E48\u0E2D\u0E19\u0E19\u0E30"
  - speakerName: "\u0E2D\u0E34\u0E07"
    text: "\u0E19\u0E31\u0E1A 1-10 \u0E40\u0E18\u0E2D\u0E44\u0E1B\u0E41\u0E2D\u0E1A\u0E14\u0E35
      \u0E46 \u0E25\u0E48\u0E30"
  - speakerName: "\u0E08\u0E31\u0E19\u0E17\u0E23\u0E4C (\u0E1C\u0E39\u0E49\u0E40\u0E25\u0E48\u0E19)"
    text: "\u0E42\u0E2D\u0E40\u0E04"
  foundDialogueLines:
  - speakerName: "\u0E2D\u0E34\u0E07"
    text: "\u0E40\u0E08\u0E2D\u0E41\u0E25\u0E49\u0E27"
